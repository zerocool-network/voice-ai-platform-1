{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "hubspot/api-client": "^14.1",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/cashier": "^16.6",
        "laravel/framework": "^13.8",
        "laravel/horizon": "^5.47",
        "laravel/reverb": "^1.10",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "*",
        "laravel/tinker": "^3.0",
        "meilisearch/meilisearch-php": "^1.11",
        "smalot/pdfparser": "^2.12",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-translation-loader": "^2.8",
        "stripe/stripe-php": "^17.6",
        "textalk/websocket": "^1.5",
        "tightenco/ziggy": "^2.0",
        "twilio/sdk": "^8.11"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.23",
        "knuckleswtf/scribe": "^5.11",
        "laravel/boost": "^2.4",
        "laravel/breeze": "^2.4",
        "laravel/dusk": "^8.6",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/wayfinder": "^0.1.20",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "nunomaduro/larastan": "^3.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install --ignore-scripts 2>/dev/null || npm install --ignore-scripts",
            "pnpm run build 2>/dev/null || npm run build"
        ],
        "phpstan": [
            "@php artisan config:clear --ansi @no_additional_args",
            "php -d memory_limit=512M vendor/bin/phpstan analyse --level 6 --no-progress"
        ],
        "phpstan-baseline": "php -d memory_limit=512M vendor/bin/phpstan analyse --level 6 --generate-baseline",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm dlx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"pnpm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "profile-seed": [
            "@php artisan db:seed --class=ProfileDataSeeder"
        ],
        "perf-test": [
            "@php artisan test --compact --group=performance"
        ],
        "load-test": [
            "k6 run tests/Load/api-load-test.js"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
